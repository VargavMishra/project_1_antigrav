# ==============================================================================
# FULL-STACK SHARED SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your root, apps/server, and apps/web as required.
# NEVER commit real secret keys, service-role keys, or database passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (apps/server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# In development: include local frontend (http://localhost:5173) and local network IPs.
# In production: replace with your deployed web app domain (e.g. https://my-web-app.vercel.app).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting: Max requests per IP window in milliseconds
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTH CONFIGURATION (Shared / Backend)
# ------------------------------------------------------------------------------
# Find these in your Supabase project dashboard -> Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (Public) Key - safe to expose in client-side code (protected by RLS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key - SECRET! Only used on the backend for administrative operations.
# NEVER expose this key in frontend code, GitHub commits, or APK bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Supabase JWT Secret - used to verify signed user tokens issued by Supabase Auth.
# Found in Supabase Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# 3. FRONTEND WEB CONFIGURATION (apps/web)
# ------------------------------------------------------------------------------
# Vite requires environment variables exposed to client-side bundles to be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# ------------------------------------------------------------------------------
# 4. MOBILE APP CONFIGURATION (apps/mobile)
# ------------------------------------------------------------------------------
# The remote web URL that the React Native WebView loads inside the mobile app.
# In development: your local network IP (e.g., http://192.168.1.100:5173).
# In production: your deployed website HTTPS URL (e.g., https://my-web-app.vercel.app).
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:5173
